# ---------------------------------------------------------------------------
# CourseScope — PRODUCTION configuration (v1.0.0)
# ---------------------------------------------------------------------------
# Committed deliberately: every value here is PUBLIC. Vite inlines VITE_*
# variables into the static bundle, so anything set here is readable by anyone
# who opens the page source. Never put a secret in this file.
#
# Loaded for `npm run build` (mode: production) — which is what the GitHub
# Pages workflow runs — and, via vite.config.ts, for `npm run build:singlefile`.

# The live site: GitHub Pages for the zhrsidd/CourseScope repository. Keep the
# trailing slash: the site lives under /CourseScope/. Used for the canonical
# link, og:url and the page address sent with feedback reports.
VITE_SITE_URL=https://zhrsidd.github.io/CourseScope/

# "Report an issue" destination: the project's Typeform. Course details are sent
# as cs_* URL parameters; the full report is also copied for pasting. Nothing is
# pre-submitted.
VITE_FEEDBACK_URL=https://form.typeform.com/to/QMMXeysE

# Share-card image, served by GitHub Pages from dist/social-preview.png.
VITE_OG_IMAGE_URL=https://zhrsidd.github.io/CourseScope/social-preview.png
