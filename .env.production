# ---------------------------------------------------------------------------
# CourseScope — PRODUCTION configuration
# ---------------------------------------------------------------------------
# Committed deliberately: every value here is PUBLIC. Vite inlines VITE_*
# variables into the static bundle, so anything set here is readable by anyone
# who opens the page source. Never put a secret in this file.
#
# Loaded for `npm run build` (mode: production) on Cloudflare Pages and the
# GitHub Pages backup, and via vite.config.ts for `npm run build:singlefile`.

# Canonical production site. GitHub Pages remains a backup deployment, but its
# build intentionally points canonical/share metadata back to Cloudflare.
VITE_SITE_URL=https://coursescope.pages.dev/

# "Report an issue" destination: the project's Typeform. Course details are sent
# as cs_* URL parameters; the full report is also copied for pasting. Nothing is
# pre-submitted.
VITE_FEEDBACK_URL=https://form.typeform.com/to/QMMXeysE

# Share-card image, served by Cloudflare Pages from dist/social-preview.png.
VITE_OG_IMAGE_URL=https://coursescope.pages.dev/social-preview.png
