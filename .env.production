# ---------------------------------------------------------------------------
# CourseScope — PRODUCTION configuration (v1.0.0)
# ---------------------------------------------------------------------------
# Committed deliberately: every value here is PUBLIC. Vite inlines VITE_*
# variables into the static bundle, so anything set here is readable by anyone
# who opens the page source. Never put a secret in this file.
#
# Loaded for `npm run build` (mode: production) and, via vite.config.ts, for
# `npm run build:singlefile` too, so both production artefacts carry the same
# configuration.
#
# Both values were supplied by the project owner for v1.0.0; neither is guessed.

# The live site: the published CourseScope page on claude.ai (the project's
# existing deployment). Used for the canonical link and og:url.
VITE_SITE_URL=https://claude.ai/artifact/ChyChvtkEFU9JYuJBaAmeH

# "Report an issue" destination: the project's Typeform. The report is copied
# to the clipboard as the form opens, ready to paste; nothing is pre-submitted.
VITE_FEEDBACK_URL=https://form.typeform.com/to/QMMXeysE

# Not set for this host. The page is served inside claude.ai's own page shell,
# so link-preview crawlers read claude.ai's metadata, not ours. A self-hosted
# deployment should set this to the absolute URL of dist/social-preview.png.
# VITE_OG_IMAGE_URL=
