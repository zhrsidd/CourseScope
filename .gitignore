# Dependencies
node_modules/

# Build output
dist/
dist-single/
# Generated: single-file bundle extracted for artifact publishing
artifact.html

# Caches
.cache/
.vite/
*.tsbuildinfo
.eslintcache

# Local environment configuration — never commit a real .env or secrets.
# .env.production IS committed: it holds only public values (the site URL, the
# feedback form link and the share image) that are inlined into the public
# bundle anyway.
.env
.env.*
!.env.example
!.env.production
*.pem
*.key

# Local QA artefacts
shots/
playwright-report/
test-results/
coverage/

# Editor / OS / machine-specific
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
